@{
    Layout = null;
}

<!doctype html>
<html lang="tr">
<head>
    <title>Yazar Şifre Sıfırlama | MVC Sözlük</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <link href="https://fonts.googleapis.com/css?family=Lato:300,400,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/AdminLTE-3.0.4/LoginWriter/css/style.css">
    <style>
        .field-icon {
            float: right;
            margin-right: 15px;
            margin-top: -33px;
            position: relative;
            z-index: 2;
            cursor: pointer;
            color: rgba(255, 255, 255, 0.8);
        }
    </style>
</head>
<body class="img js-fullheight" style="background-image: url(/AdminLTE-3.0.4/LoginWriter/images/bg.jpg);">
    <section class="ftco-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 text-center mb-4">
                    <h2 class="heading-section">Yazar Şifre Sıfırlama</h2>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-4">
                    <div class="login-wrap p-0">
                        <p class="text-center text-white-50 mb-4" style="font-size: 14px;">
                            Kayıtlı e-posta adresinizi ve yeni şifrenizi girerek hesabınızı güncelleyebilirsiniz.
                        </p>

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div class="alert alert-danger text-center" style="font-size: 14px; padding: 10px; margin-bottom: 15px; border-radius: 5px;">
                                @ViewBag.ErrorMessage
                            </div>
                        }

                        @using (Html.BeginForm("WriterForgotPassword", "Login", FormMethod.Post))
                        {
                            <div class="form-group">
                                <input type="email" class="form-control" placeholder="Kayıtlı E-Posta Adresiniz" name="writerMail" required>
                            </div>
                            <div class="form-group">
                                <input id="writerPassword" type="password" class="form-control" placeholder="Yeni Şifre" name="newPassword" required>
                                <span toggle="#writerPassword" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                            </div>
                            <div class="form-group">
                                <input id="writerPasswordRepeat" type="password" class="form-control" placeholder="Yeni Şifre Tekrar" name="confirmPassword" required>
                                <span toggle="#writerPasswordRepeat" class="fa fa-fw fa-eye field-icon toggle-password"></span>
                                <span id="passwordMessage" style="display:block; margin-top: 6px; font-size: 13px; font-weight: 600;"></span>
                            </div>
                            <div class="form-group mt-4">
                                <button type="submit" class="form-control btn btn-primary submit px-3">ŞİFREYİ GÜNCELLE</button>
                            </div>
                        }

                        <div class="text-center mt-4 d-flex justify-content-around">
                            <a href="/Login/WriterLogin/" style="color: #fff; text-decoration: underline; font-size: 14px;">
                                <i class="fa fa-arrow-left mr-1"></i> Giriş Yap
                            </a>
                            <a href="/Home/HomePage/" style="color: #fff; text-decoration: underline; font-size: 14px;">
                                <i class="fa fa-home mr-1"></i> Ana Sayfa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="~/AdminLTE-3.0.4/LoginWriter/js/jquery.min.js"></script>
    <script src="~/AdminLTE-3.0.4/LoginWriter/js/popper.js"></script>
    <script src="~/AdminLTE-3.0.4/LoginWriter/js/bootstrap.min.js"></script>
    <script src="~/AdminLTE-3.0.4/LoginWriter/js/main.js"></script>
    <script>
        $(document).ready(function () {
            $(".toggle-password").click(function () {
                $(this).toggleClass("fa-eye fa-eye-slash");
                var input = $($(this).attr("toggle"));
                if (input.attr("type") === "password") {
                    input.attr("type", "text");
                } else {
                    input.attr("type", "password");
                }
            });

            $("#writerPassword, #writerPasswordRepeat").on("keyup", function () {
                var p1 = $("#writerPassword").val();
                var p2 = $("#writerPasswordRepeat").val();
                if (p2 === "") {
                    $("#passwordMessage").text("");
                    return;
                }
                if (p1 !== p2) {
                    $("#passwordMessage").text("Şifreler eşleşmiyor.").css("color", "#ff6b6b");
                } else {
                    $("#passwordMessage").text("Şifreler eşleşiyor.").css("color", "#51cf66");
                }
            });

            $("form").on("submit", function (e) {
                var p1 = $("#writerPassword").val();
                var p2 = $("#writerPasswordRepeat").val();
                if (p1 !== p2) {
                    e.preventDefault();
                    $("#passwordMessage").text("Şifreler eşleşmiyor.").css("color", "#ff6b6b");
                }
            });
        });
    </script>
</body>
</html>
