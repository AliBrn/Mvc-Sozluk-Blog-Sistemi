@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Şifre Sıfırlama | MVC Sözlük</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow-x: hidden;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #6b7ff0 0%, #a92df0 55%, #d900ff 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .login-container {
            width: 100%;
            max-width: 400px;
            background: #fff;
            border-radius: 8px;
            padding: 38px 34px 32px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
        }

        .title {
            text-align: center;
            font-size: 24px;
            font-weight: 700;
            color: #252525;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            font-size: 13px;
            color: #666;
            margin-bottom: 26px;
            line-height: 1.4;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                font-size: 12px;
                color: #444;
                margin-bottom: 6px;
                font-weight: 600;
            }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper input {
                width: 100%;
                height: 42px;
                border: none;
                border-bottom: 2px solid #ddd;
                outline: none;
                padding: 0 5px 0 28px;
                font-size: 13px;
                color: #333;
                background: transparent;
                transition: border-color 0.2s;
            }

                .input-wrapper input:focus {
                    border-bottom-color: #8e46ed;
                }

        .input-icon {
            position: absolute;
            left: 3px;
            top: 12px;
            color: #aaa;
            font-size: 15px;
        }

        .buttons {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 24px;
        }

        .login-btn,
        .home-btn {
            width: 100%;
            height: 42px;
            border: none;
            border-radius: 25px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .login-btn {
            background: linear-gradient(90deg, #10cbd0, #c800ff);
            color: white;
            box-shadow: 0 4px 12px rgba(177, 0, 255, 0.25);
        }

            .login-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 15px rgba(177, 0, 255, 0.35);
            }

        .home-btn {
            background: #eee;
            color: #555;
        }

            .home-btn:hover {
                background: #e2e2e2;
            }

        @@media (max-width: 500px) {
            .login-container {
                max-width: 340px;
                padding: 30px 24px 26px;
            }

            .title {
                font-size: 21px;
            }
        }
    </style>
</head>

<body>
    <div class="login-container">
        <h1 class="title">Şifre Sıfırlama</h1>
        <p class="subtitle">Kayıtlı kullanıcı adınızı ve yeni şifrenizi giriniz.</p>

        @if (ViewBag.ErrorMessage != null)
        {
            <div style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 5px; margin-bottom: 18px; font-size: 13px; text-align: center;">
                @ViewBag.ErrorMessage
            </div>
        }

        @using (Html.BeginForm("AdminForgotPassword", "Login", FormMethod.Post, new { id = "adminResetForm" }))
        {
            <div class="form-group">
                <label for="username">Kullanıcı Adı veya E-Posta</label>
                <div class="input-wrapper">
                    <span class="input-icon">👤</span>
                    <input type="text"
                           name="adminUserName"
                           id="username"
                           placeholder="Kullanıcı adınızı giriniz"
                           required>
                </div>
            </div>

            <div class="form-group">
                <label for="adminPassword">Yeni Şifre</label>
                <div class="input-wrapper">
                    <span class="input-icon">🔒</span>
                    <input type="password"
                           name="newPassword"
                           id="adminPassword"
                           placeholder="Yeni şifrenizi giriniz"
                           required>
                </div>
            </div>

            <div class="form-group">
                <label for="adminPasswordRepeat">Yeni Şifre Tekrar</label>
                <div class="input-wrapper">
                    <span class="input-icon">🔑</span>
                    <input type="password"
                           name="confirmPassword"
                           id="adminPasswordRepeat"
                           placeholder="Yeni şifrenizi tekrar giriniz"
                           required>
                </div>
                <span id="passwordMessage" style="display:block; margin-top: 6px; font-size: 12px; font-weight: 600;"></span>
            </div>

            <div class="buttons">
                <button type="submit" class="login-btn">
                    ŞİFREYİ GÜNCELLE
                </button>

                <button type="button" class="home-btn" onclick="window.location.href='/Login/Index/'">
                    GİRİŞ EKRANINA DÖN
                </button>

                <button type="button" class="home-btn" onclick="window.location.href='/Home/HomePage/'">
                    ANA SAYFAYA DÖN
                </button>
            </div>
        }
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#adminPassword, #adminPasswordRepeat").on("keyup", function () {
                var p1 = $("#adminPassword").val();
                var p2 = $("#adminPasswordRepeat").val();
                if (p2 === "") {
                    $("#passwordMessage").text("");
                    return;
                }
                if (p1 !== p2) {
                    $("#passwordMessage").text("Şifreler eşleşmiyor.").css("color", "#dc3545");
                } else {
                    $("#passwordMessage").text("Şifreler eşleşiyor.").css("color", "#28a745");
                }
            });

            $("#adminResetForm").on("submit", function (e) {
                var p1 = $("#adminPassword").val();
                var p2 = $("#adminPasswordRepeat").val();
                if (p1 !== p2) {
                    e.preventDefault();
                    $("#passwordMessage").text("Şifreler eşleşmiyor.").css("color", "#dc3545");
                }
            });
        });
    </script>
</body>
</html>
