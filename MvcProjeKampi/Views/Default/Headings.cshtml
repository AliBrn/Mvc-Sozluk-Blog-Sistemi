@using EntityLayer.Concrete
@model List<Heading>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="x-ua-compatible" content="ie=edge">

    <title>MVC SÖZLÜK</title>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="~\AdminLTE-3.0.4\plugins/fontawesome-free/css/all.min.css">
    <!-- IonIcons -->
    <link rel="stylesheet" href="http://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~\AdminLTE-3.0.4\dist/css/adminlte.min.css">
    <!-- Google Font: Source Sans Pro -->
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">
</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Sol Menü Butonları -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item">
                    <a href="/Home/HomePage/" class="nav-link font-weight-bold text-primary">
                        <i class="fas fa-home mr-1"></i> Siteye Git
                    </a>
                </li>
            </ul>

            <!-- Sağ Butonlar (Yazar & Admin Girişleri) -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item mr-2">
                    <a href="/Login/WriterLogin/" class="btn btn-primary btn-sm">
                        <i class="fas fa-pen mr-1"></i> Yazar Girişi
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Login/Index/" class="btn btn-dark btn-sm">
                        <i class="fas fa-user-shield mr-1"></i> Admin Girişi
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="/Home/HomePage/" class="brand-link">
                <img src="~\AdminLTE-3.0.4\dist/img/AdminLTELogo.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3"
                     style="opacity: .8">
                <span class="brand-text font-weight-light">MVC Sözlük</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar user panel (optional) -->
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <img src="~\AdminLTE-3.0.4\dist/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User Image">
                    </div>
                    <div class="info">
                        <a href="/Home/HomePage/" class="d-block">MVC VİTRİN</a>
                    </div>
                </div>

                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        @foreach (var item in Model)
                        {
                            <li class="nav-item">
                                <a href="/Default/Headings/@item.HeadingID" class="nav-link">
                                    <p>
                                        @item.HeadingName
                                    </p>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">

            <!-- Main content -->
            <div class="content">
                @Html.Action("Index", "Default")
                <!-- /.container-fluid -->
            </div>
            <!-- /.content -->
        </div>
        <!-- /.content-wrapper -->




    </div>
    <!-- ./wrapper -->
    <!-- REQUIRED SCRIPTS -->
    <!-- jQuery -->
    <script src="~\AdminLTE-3.0.4\plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap -->
    <script src="~\AdminLTE-3.0.4\plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE -->
    <script src="~\AdminLTE-3.0.4\dist/js/adminlte.js"></script>

    <!-- OPTIONAL SCRIPTS -->
    <script src="~\AdminLTE-3.0.4\plugins/chart.js/Chart.min.js"></script>
    <script src="~\AdminLTE-3.0.4\dist/js/demo.js"></script>
    <script src="~\AdminLTE-3.0.4\dist/js/pages/dashboard3.js"></script>
</body>
</html>