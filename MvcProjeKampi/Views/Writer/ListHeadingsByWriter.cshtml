@using EntityLayer.Concrete
@model List<Heading>
@{
    ViewBag.Title = "ListHeadingsByWriter";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>@(ViewBag.WriterName != null ? ViewBag.WriterName + " - Başlıkları" : "Yazarın Başlıkları")</h2>
<br />
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th style="width: 5%">#</th>
            <th style="width: 35%">Başlık Adı</th>
            <th style="width: 20%">Kategori</th>
            <th style="width: 15%">Tarih</th>
            <th style="width: 10%">Durum</th>
            <th style="width: 15%">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.HeadingID</td>
                    <td>@item.HeadingName</td>
                    <td>@item.Category.CategoryName</td>
                    <td>@(((DateTime)item.HeadingDate).ToString("dd-MMM-yyyy"))</td>
                    <td>
                        @if (item.HeadingStatus)
                        {
                            <span class="badge badge-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">Pasif</span>
                        }
                    </td>
                    <td>
                        <a class="btn btn-primary btn-sm" href="/Content/ContentByHeading/@item.HeadingID">
                            <i class="fas fa-folder"></i> Yazılar
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Bu yazara ait henüz bir başlık bulunmamaktadır.</td>
            </tr>
        }
    </tbody>
</table>
<br />
<a href="/Writer/Index" class="btn btn-default">
    <i class="fas fa-arrow-left"></i> Yazarlar Listesine Dön
</a>
