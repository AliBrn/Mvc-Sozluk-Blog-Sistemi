@using EntityLayer.Concrete
@model List<Writer>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<!DOCTYPE html>
<html>

<body class="hold-transition sidebar-mini">


    <!-- /.navbar -->
    <!-- Main Sidebar Container -->
    <!-- Content Wrapper. Contains page content -->
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Yazarlar</h1>
                </div>

            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">

        <!-- Default box -->
        <div class="card card-solid">
            <div class="card-body pb-0">
                <div class="row d-flex align-items-stretch">
                    @foreach (var item in Model)
                    {
                        <!-- 1. flex-column ve d-flex ile sütunun tüm boyu alması sağlanır: -->
                        <div class="col-12 col-sm-6 col-md-4 d-flex align-items-stretch flex-column">

                            <!-- 2. d-flex flex-fill: Kartın tüm sütunu %100 doldurmasını sağlar: -->
                            <div class="card bg-light d-flex flex-fill">

                                <!-- 3. Ünvan boşsa tasarım çökmesin diye varsayılan 'Yazar' yazar: -->
                                <div class="card-header text-muted border-bottom-0">
                                    @(string.IsNullOrEmpty(item.WriterTitle) ? "Yazar" : item.WriterTitle)
                                </div>

                                <div class="card-body pt-0 d-flex flex-column">
                                    <div class="row flex-grow-1">
                                        <div class="col-7">
                                            <h2 class="lead"><b>@item.WriterName @item.WriterSurName</b></h2>

                                            <!-- 4. Hakkında yazısını 2 satırda sınırlar (... ile keser), böylece kutuların boyu şaşmaz: -->
                                            <p class="text-muted text-sm mb-2" style="min-height: 40px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;" title="@item.WriterAbout">
                                                <b>Hakkında: </b> @item.WriterAbout
                                            </p>

                                            <ul class="ml-4 mb-0 fa-ul text-muted">
                                                <li class="small"><span class="fa-li"><i class="fas fa-lg fa-envelope"></i></span> @item.WriterMail</li>
                                            </ul>
                                        </div>

                                        <!-- 5. Resim boyutu 100x100 piksele sabitlenir, object-fit ile yuvarlak ve pürüzsüz kırpılır: -->
                                        <div class="col-5 text-center d-flex align-items-center justify-content-center">
                                            <img src="@(string.IsNullOrEmpty(item.WriterImage) ? "/AdminLTE-3.0.4/dist/img/user1-128x128.jpg" : item.WriterImage)"
                                                 alt=""
                                                 class="img-circle img-fluid"
                                                 style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%;">
                                        </div>
                                    </div>
                                </div>

                                <!-- 6. Footer daima en alt tabana yapışır: -->
                                <div class="card-footer">
                                    <div class="text-right">
                                        <a href="/Writer/ListHeadingsByWriter/@item.WriterID" class="btn btn-sm bg-teal">
                                            <i class="fas fa-comments"></i> Yazarın Başlıkları
                                        </a>
                                        <a href="/Writer/WriterEdit/@item.WriterID" class="btn btn-sm btn-primary">
                                            <i class="fas fa-user"></i> Profili Düzenle
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>
            <!-- /.card-body -->
            <!-- /.card-footer -->
        </div>
        <!-- /.card -->

    </section>
    <!-- /.content -->


</body>
</html>
