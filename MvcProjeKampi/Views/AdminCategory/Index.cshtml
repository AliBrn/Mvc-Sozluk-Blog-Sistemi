@using EntityLayer.Concrete  <!--Entity ilk sınıfdan kalıtım alıyoruz  o yüzden orayı yazdık en üstte-->
@model List<Category>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Kategori Adı</th>
            <th>Kategori Açıklama</th>
            <th>Sil</th>
            <th>Güncelle</th>
            <th>Başlıklar</th>
        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CategoryID</td>
            <td>@item.CategoryName</td>
            <td>@item.CategoryDescription</td>
            <td> <a class="btn btn-danger btn-delete " href="/AdminCategory/CategoryDelete/@item.CategoryID">Sil</a> </td>
            <td> <a class="btn btn-warning" href="/AdminCategory/CategoryEdit/@item.CategoryID">Güncelle</a> </td>
            <td> <a class="btn btn-primary " href="/AdminCategory/ListHeadingsByCategory/@item.CategoryID">Başlıklar</a> </td>
        </tr>
    }

</table>
<a href="/AdminCategory/CategoryAdd/" class="btn btn-info">Ekle</a>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).on('click', '.btn-delete', function (e) {
        e.preventDefault();

        var url = $(this).attr('href');

        Swal.fire({
            title: 'Emin misiniz?',
            text: 'Bu kaydı silmek istediğinize emin misiniz?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Evet, Sil',
            cancelButtonText: 'Vazgeç'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = url;
            }
        });
    });
</script>