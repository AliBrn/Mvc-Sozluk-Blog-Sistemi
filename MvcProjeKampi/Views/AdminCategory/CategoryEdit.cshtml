@model EntityLayer.Concrete.Category
@{
    ViewBag.Title = "CategoryEdit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>CategoryEdit</h2>

@using (Html.BeginForm("CategoryEdit", "AdminCategory", FormMethod.Post)) // Action ismi,Controller ismi
{
    <div class="form-group">
        @Html.HiddenFor(x => x.CategoryID, new { @class = "form-control" })

        @Html.Label("Güncellencek Kategori Adı")
        @Html.TextBoxFor(x => x.CategoryName, new { @class = "form-control" })
        <br />
        @Html.Label("Güncellencek Kategori Açıklaması")
        @Html.TextBoxFor(x => x.CategoryDescription, new { @class = "form-control" })
        <br />
        <button class="btn btn-success">Güncelle</button>
    </div>


}