@model EntityLayer.Concrete.Category
@{
    Layout = null;
}
@{
    ViewBag.Title = "AddCategory";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
@using (Html.BeginForm("CategoryAdd", "AdminCategory", FormMethod.Post)) // Action ismi,Controller ismi
{
    <div class="form-group">
        @Html.Label("Kategori Adı")
        @Html.TextBoxFor(x => x.CategoryName, new { @class = "form-control"}) <!-- Kullanıcı bu halde mesaj görmüyor-->
        @Html.ValidationMessageFor(x => x.CategoryName)
        <br />
        <br />
        @Html.Label("Kategori Açıklaması")
        @Html.TextAreaFor(x => x.CategoryDescription, new { @class = "form-control"})
        @Html.ValidationMessageFor(x => x.CategoryDescription) <!-- Validation hatalarını gösteriyor summary olan tüm hatalarını gösteriri-->
        <br />
        <button class="btn btn-danger">Kaydet</button>
    </div>


}

