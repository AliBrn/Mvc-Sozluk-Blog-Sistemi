
@{
    ViewBag.Title = "ColumnChart";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Sütun Grafiği</h2>
<script type="text/javascript"
        src="https://www.gstatic.com/charts/loader.js"></script>

<div class="container-fluid">

    <div class="card">

        <div class="card-header">
            <h3 class="card-title">Yazarlara Göre Başlık Sayıları</h3>
        </div>

        <div class="card-body">

            <div id="columnchart" style="width: 100%; height: 400px;"></div>

        </div>

    </div>

</div>

<script>

    google.charts.load('current', {
        packages: ['corechart']
    });

    google.charts.setOnLoadCallback(drawChart);

    function drawChart() {

        var data = google.visualization.arrayToDataTable([

            ['Yazar', 'Başlık Sayısı'],

            @foreach (var item in ViewBag.ChartData)
            {
                <text>
                    ['@Html.Raw(item.Key)', @item.Value],
                </text>
            }

        ]);

        var options = {
            title: 'Yazarlara Göre Başlık Sayıları'
        };

        var chart = new google.visualization.ColumnChart(
            document.getElementById('columnchart')
        );

        chart.draw(data, options);
    }

</script>