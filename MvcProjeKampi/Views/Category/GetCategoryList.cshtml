@using EntityLayer.Concrete
@model List<Category>
@{
    Layout = null;


}
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<table class="table table-hover">
    <thead>
        <tr>
            <th>Kategori ID</th>
            <th>Kategori Adı</th>
            <th>Kategori Açıklama</th>
            <th>Durum</th>
            <th>Güncelle</th>
        </tr>
    </thead>
     @foreach(var item in Model)
     { 
       <tr>
                  <td>@item.CategoryID</td>
                  <td>@item.CategoryName</td>
                  <td>@item.CategoryDescription</td>
                  <td>@item.CategoryStatus</td>
                  <td> <button class="btn btn-success">Güncelle</button> </td>
       </tr>
       }
   
   </table>
 <a href="/Category/CategoryAdd/" class="btn btn-info">Ekle</a>