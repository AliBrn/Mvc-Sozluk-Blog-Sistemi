@model EntityLayer.Concrete.Category
@{
    Layout = null;
}
<!-- Kategori  Ekleme işlemi html helpersız-->
<h2> Kategori Ekleme Sayfası</h2>
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />

@using (Html.BeginForm("CategoryAdd", "Category", FormMethod.Post)) // Action ismi,Controller ismi
{
    <div class="form-group">
        @Html.Label("KategoriAdı")
        @Html.TextBoxFor(x=>x.CategoryName) <!-- Kullanıcı bu halde mesaj görmüyor-->
        @Html.ValidationMessageFor(x=>x.CategoryName)
        <br />
        <br />
        @Html.Label("Kateogir Açıklaması")
        @Html.TextBoxFor(x => x.CategoryDescription)
        @Html.ValidationMessageFor(x => x.CategoryDescription)
        <br />
        <button>Kaydet</button>
    </div>


}
