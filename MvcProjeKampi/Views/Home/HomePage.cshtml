    <!--Şifre Kontrol Scripti-->
    <script>
        // Script şifre kontrolü yapılıyor
        $(document).ready(function () {

            $("#writerPassword, #writerPasswordRepeat").on("keyup", function () {

                var password = $("#writerPassword").val();
                var passwordRepeat = $("#writerPasswordRepeat").val();

                if (passwordRepeat === "") {
                    $("#passwordMessage").text("");
                    return;
                }

                if (password !== passwordRepeat) {

                    $("#passwordMessage")
                        .text("Şifreler eşleşmiyor.")
                        .removeClass("password-success")
                        .addClass("password-error");

                } else {

                    $("#passwordMessage")
                        .text("Şifreler eşleşiyor.")
                        .removeClass("password-error")
                        .addClass("password-success");

                }

            });


            $("#writerRegisterForm").on("submit", function (e) {

                var password = $("#writerPassword").val();
                var passwordRepeat = $("#writerPasswordRepeat").val();

                if (password !== passwordRepeat) {

                    e.preventDefault();

                    $("#passwordMessage")
                        .text("Şifreler eşleşmiyor.")
                        .removeClass("password-success")
                        .addClass("password-error");

                }

            });

        });
    </script>
