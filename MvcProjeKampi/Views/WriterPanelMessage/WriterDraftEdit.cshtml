@model EntityLayer.Concrete.Message
@{
    ViewBag.Title = "WriterDraftEdit";
    Layout = "~/Views/Shared/_WriterLayout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="~/AdminLTE-3.0.4/plugins/summernote/summernote-bs4.css">
</head>
<body class="hold-transition sidebar-mini">

    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Taslağı Düzenle</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                @Html.Action("WriterMessageListMenu", "WriterPanelMessage")

                <div class="col-md-9">
                    @using (Html.BeginForm("WriterDraftEdit", "WriterPanelMessage", FormMethod.Post))
                    {
                        <!-- Hangi taslak olduğunu bilmesi için ID'yi gizli tutuyoruz: -->
                        @Html.HiddenFor(x => x.MessageID)

                        <div class="card card-primary card-outline">
                            <div class="card-header">
                                <h3 class="card-title">Taslak Mesajı Düzenle & Gönder</h3>
                            </div>

                            <div class="card-body">
                                <div class="form-group">
                                    @Html.Label("Alıcı")
                                    @Html.TextBoxFor(x => x.ReceiverMail, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(x => x.ReceiverMail)
                                </div>
                                <div class="form-group">
                                    @Html.Label("Konu")
                                    @Html.TextBoxFor(x => x.Subject, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(x => x.Subject)
                                </div>
                                <div class="form-group">
                                    <label>Mesajınız</label>
                                    <textarea id="compose-textarea" name="MessageContent" class="form-control" style="height: 300px">@Model.MessageContent</textarea>
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="float-right">
                                    <!-- Taslağı Güncelle Butonu -->
                                    <button type="submit" name="btnAction" value="draft" class="btn btn-default">
                                        <i class="fas fa-pencil-alt"></i> Taslağı Güncelle
                                    </button>
                                    <!-- Gönder Butonu -->
                                    <button type="submit" name="btnAction" value="send" class="btn btn-primary">
                                        <i class="far fa-envelope"></i> Gönder
                                    </button>
                                </div>
                                <!-- Taslağı Sil Butonu (SweetAlert2 ile Onaylı) -->
                                <a href="/WriterPanelMessage/WriterDraftDelete/@Model.MessageID" class="btn btn-danger btn-delete-draft">
                                    <i class="fas fa-trash"></i> Taslağı Sil
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <script src="~/AdminLTE-3.0.4/plugins/summernote/summernote-bs4.min.js"></script>
    <script>
        $(function () {
            // Summernote zengin metin editörü:
            $('#compose-textarea').summernote();

            // Taslak Silme SweetAlert2 Onayı (v9 ve v11 uyumlu):
            $(document).on('click', '.btn-delete-draft', function (e) {
                e.preventDefault();
                var url = $(this).attr('href');

                Swal.fire({
                    title: 'Taslağı Silmek İstiyor Musunuz?',
                    text: 'Bu taslak mesaj kalıcı olarak silinecektir!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-trash"></i> Evet, Sil',
                    cancelButtonText: '<i class="fas fa-times"></i> Vazgeç',
                    reverseButtons: true
                }).then(function (result) {
                    // SweetAlert v9'da result.value, v10+'da result.isConfirmed döner:
                    if (result && (result.value === true || result.isConfirmed === true)) {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
</body>
</html>
