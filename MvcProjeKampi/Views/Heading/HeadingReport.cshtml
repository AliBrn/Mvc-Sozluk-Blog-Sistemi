@using EntityLayer.Concrete
@model List<Heading>

@{
    ViewBag.Title = "HeadingReport";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- DataTables CSS -->
<link rel="stylesheet"
      href="https://cdn.datatables.net/1.10.19/css/dataTables.bootstrap4.min.css">

<link rel="stylesheet"
      href="https://cdn.datatables.net/buttons/1.5.2/css/buttons.bootstrap4.min.css">

<link rel="stylesheet"
      href="https://cdn.datatables.net/responsive/2.2.3/css/responsive.bootstrap4.min.css">


<div class="container-fluid">

    <h3 class="mb-4">Başlık Raporu</h3>

    <table id="example"
           class="table table-striped table-bordered dt-responsive nowrap"
           style="width:100%">

        <thead>
            <tr>
                <th>Başlık ID</th>
                <th>Başlık Adı</th>
                <th>Başlık Tarihi</th>
                <th>Başlık Yazar Ad ve Soyad</th>
                <th>Başlık Kategorisi</th>
                <th>Başlık Durumu</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.HeadingID</td>

                    <td>@x.HeadingName</td>

                    <td>
                        @x.HeadingDate.ToString("dd.MM.yyyy")
                    </td>

                    <td>
                        @x.Writer.WriterName
                        @x.Writer.WriterSurName
                    </td>

                    <td>
                        @x.Category.CategoryName
                    </td>

                    <td>
                        @x.HeadingStatus
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>


<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.3.1.js"></script>

<!-- DataTables -->
<script src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.19/js/dataTables.bootstrap4.min.js"></script>

<!-- DataTables Buttons -->
<script src="https://cdn.datatables.net/buttons/1.5.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/1.5.2/js/buttons.bootstrap4.min.js"></script>

<!-- Excel -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>

<!-- PDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.36/vfs_fonts.js"></script>

<!-- Export -->
<script src="https://cdn.datatables.net/buttons/1.5.2/js/buttons.html5.min.js"></script>

<!-- Print -->
<script src="https://cdn.datatables.net/buttons/1.5.2/js/buttons.print.min.js"></script>

<!-- Column Visibility -->
<script src="https://cdn.datatables.net/buttons/1.5.2/js/buttons.colVis.min.js"></script>

<!-- Responsive -->
<script src="https://cdn.datatables.net/responsive/2.2.3/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.2.3/js/responsive.bootstrap4.min.js"></script>


<script>
    // html Tablomu    datatable dönüştürüyor  alttakilerde sayfalama,aramaa,sıralama özellikleri açık
    $(document).ready(function () {

        var table = $('#example').DataTable({

            pageLength: 10,

            searching: true,

            ordering: true,

            responsive: true,

            buttons: [
                'copy',
                'excel',
                'csv',
                'pdf',
                'print',
                'colvis'
            ],

            language: {
                search: "Ara:",
                lengthMenu: "_MENU_ kayıt göster",
                info: "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                infoEmpty: "Kayıt bulunamadı",
                zeroRecords: "Eşleşen kayıt bulunamadı",

                paginate: {
                    first: "İlk",
                    last: "Son",
                    next: "Sonraki",
                    previous: "Önceki"
                },

                buttons: {
                    copy: "Kopyala",
                    print: "Yazdır",
                    colvis: "Sütunlar"
                }
            }

        });


        table.buttons().container()
            .appendTo('#example_wrapper .col-md-6:eq(0)');

    });

</script>