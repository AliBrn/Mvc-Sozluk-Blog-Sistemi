@model EntityLayer.Concrete.Heading
@{
    ViewBag.Title = "HeadingEdit";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>HeadingEdit</h2>

@using (Html.BeginForm("HeadingEdit", "Heading", FormMethod.Post))
{
  <div class="form-group">
      @Html.HiddenFor(x => x.HeadingID, new { @class = "form-control" })

      @Html.Label("Başlık Adı")
      @Html.TextBoxFor(x => x.HeadingName, new { @class = "form-control" })
      <br />
      @Html.Label("Başlık Tarihi")
      @Html.TextBoxFor(x => x.HeadingDate, new { @class = "form-control" })
      <br />
      @Html.Label("Başlığın Kategorisi")
      @Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.ctgrvalue, new { @class = "form-control" })
      <br />
      @Html.Label("Başlık Yazarı ") 
      @Html.DropDownListFor(x => x.WriterID,(List<SelectListItem>)ViewBag.yzrvalue, new { @class = "form-control" })
      <br />
      <button class="btn btn-success">Güncelle</button>
  </div>
}

