@using EntityLayer.Concrete
@model List<Admin>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Admin Listesi ve Yetkilendirme</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Admin Mail</th>
            <th>Yetki</th>
            <th>Status</th>
            <th>Durum (Aktif/Pasif)</th>
            <th>Yetkisini Değiştir</th>
        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.AdminID</td>
            <td>@item.AdminUserName</td>
            <td><span class="badge badge-info">@item.AdminRole</span></td>

            <!-- Durum Rozeti -->
            <td>
                @if (item.AdminStatus)
                {
                    <span class="badge badge-success">Aktif</span>
                }
                else
                {
                    <span class="badge badge-danger">Pasif</span>
                }
            </td>

            <!-- Aktif / Pasif Butonu -->
            <!-- Aktif / Pasif Butonu (Sadece C görür): -->
            <td>
                @if (User.IsInRole("C"))
                {
                    if (item.AdminRole == "C")
                    {
                        <span class="text-muted"><i class="fas fa-lock"></i> Kilitli</span>
                    }
                    else if (item.AdminStatus)
                    {
                        <form method="post" action="/Authorization/PasifYap" class="form-status-toggle" data-status-text="pasif" style="display:inline;">
                            <input type="hidden" name="id" value="@item.AdminID" />
                            <button type="submit" class="btn btn-sm btn-danger">
                                Pasif Yap
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" action="/Authorization/AktifYap" class="form-status-toggle" data-status-text="aktif" style="display:inline;">
                            <input type="hidden" name="id" value="@item.AdminID" />
                            <button type="submit" class="btn btn-sm btn-success">
                                Aktif Yap
                            </button>
                        </form>
                    }
                }
                else
                {
                    <span class="text-muted">Yetkiniz Yok</span>
                }
            </td>

            <!-- Yetki Değiştir Butonu (Sadece C görür): -->
            <td>
                @if (User.IsInRole("C"))
                {
                    if (item.AdminRole == "C")
                    {
                        <span class="text-muted"><i class="fas fa-lock"></i> Kilitli</span>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-warning" href="/Authorization/AdminUpdate/@item.AdminID">
                            Yetkiyi Değiştir
                        </a>
                    }
                }
                else
                {
                    <span class="text-muted">Yetkiniz Yok</span>
                }
            </td>
        </tr>
    }
</table>

@if (User.IsInRole("B") || User.IsInRole("C"))
{
    <a href="/Authorization/AdminAdd/" class="btn btn-info">Yeni Admin Ekle</a>
}

<!-- SweetAlert Bildirim ve Onay Scriptleri -->
@if (TempData["SweetAlertSuccess"] != null)
{
    <script>
        $(document).ready(function () {
            Swal.fire({
                icon: 'success',
                title: 'İşlem Başarılı',
                text: '@Html.Raw(TempData["SweetAlertSuccess"])',
                timer: 2500,
                showConfirmButton: false
            });
        });
    </script>
}

<script>
    $(document).on('submit', '.form-status-toggle', function (e) {
        var form = this;
        if ($(form).data('confirmed') === true) {
            return true;
        }

        e.preventDefault();
        var statusText = $(form).data('status-text');
        var isPasif = (statusText === 'pasif');

        Swal.fire({
            title: 'Emin misiniz?',
            text: 'Bu admin hesabını ' + (isPasif ? 'pasif' : 'aktif') + ' duruma getirmek istediğinize emin misiniz?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: isPasif ? '#d33' : '#28a745',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Evet, ' + (isPasif ? 'Pasif Yap' : 'Aktif Yap'),
            cancelButtonText: 'Vazgeç'
        }).then(function (result) {
            // SweetAlert2 v9'da result.value, v10+'da result.isConfirmed kullanılır:
            if (result && (result.value === true || result.isConfirmed === true)) {
                $(form).data('confirmed', true);
                if (typeof form.submit === 'function') {
                    form.submit();
                } else {
                    HTMLFormElement.prototype.submit.call(form);
                }
            } else if (result && (result.dismiss === 'cancel' || (typeof Swal !== 'undefined' && result.dismiss === Swal.DismissReason.cancel))) {
                Swal.fire({
                    icon: 'info',
                    title: 'İptal Edildi',
                    text: 'İşlem iptal edildi, durum değiştirilmedi.',
                    timer: 1500,
                    showConfirmButton: false
                });
            }
        });
    });
</script>








